    "commentsEn": "<ul>\r\n\t<li style=\"text-align: justify;\"><span style=\"font-size:12px;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"line-height: 20.7999992370605px;\">SABIC owns 100% of the project through its wholly owned subsidiary Saudi Iron &amp; Steel Company (Hadeed).</span></span></span></li>\r\n</ul>\r\n",
    "commentsAr": "<ul>\r\n\t<li style=\"text-align: justify;\"><span style=\"font-size:12px;\"><span style=\"font-family:times new roman,times,serif;\">تمتلك سابك 100% من المشروع من خلال الشركة السعودية للحديد و الصلب (حديد) المملوكة لها كلياً.</span></span></li>\r\n\t<li style=\"text-align: justify;\"><span style=\"font-size:12px;\"><span style=\"font-family:times new roman,times,serif;\">بدأ المصنع انتاجة التجارى و انتج نحو 130 الف طن من لفائف الاسلاك </span></span><span style=\"font-family: 'times new roman', times, serif; font-size: 12px; line-height: 19.2000007629395px; text-align: justify;\">&nbsp;بنهاية عام 2013</span><span style=\"font-size:12px;\"><span style=\"font-family:times new roman,times,serif;\">، و توقعت الشركة ان يصل للطاقة التصميمية بنهاية عام 2014، ليغطى هو و مصنع لفات الاسلاك 1 الطلب المحلى للفات الاسلاك، و لكن لم تعلن الشركة عن التطورات.</span></span></li>\r\n</ul>\r\n\r\n<div style=\"text-align: justify;\">&nbsp;</div>\r\n\r\n<div style=\"text-align: justify;\">&nbsp;</div>\r\n",
