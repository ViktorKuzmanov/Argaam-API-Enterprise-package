    "commentsEn": "<ul>\r\n\t<li style=\"text-align: justify;\"><span style=\"line-height:normal;\"><span style=\"font-size:12px;\"><span style=\"font-family:times new roman,times,serif;\">SABIC owns 35% &amp; 100% of Saudi Kayan &amp; </span></span></span><span style=\"font-family: 'times new roman', times, serif; font-size: 11.8181819915771px; line-height: normal; text-align: justify;\">Petrokemya&nbsp;</span><span style=\"line-height:normal;\"><span style=\"font-size:12px;\"><span style=\"font-family:times new roman,times,serif;\">respectively.</span></span></span></li>\r\n\t<li style=\"text-align: justify;\"><span style=\"line-height:normal;\"><span style=\"font-size:12px;\"><span style=\"font-family:times new roman,times,serif;\">Saudi Kayan announced, on November 2013, cancelling the project because the results of the initial feasibility studies don&#39;t align with the company&#39;s development strategy.</span></span></span></li>\r\n</ul>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n",
    "commentsAr": "<ul>\r\n\t<li style=\"text-align: justify;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size: 12px; line-height: normal; text-align: right;\">&nbsp;تمتلك سابك نسبة 35% و 100% من شركة كيان السعودية وشركة بتروكيميا على التوالي.</span></span></li>\r\n\t<li style=\"text-align: justify;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size: 12px; line-height: normal; text-align: right;\"><span style=\"font-family:times new roman,times,serif;\"><span style=\"font-size: 12px; line-height: normal; text-align: justify;\">&nbsp;أعلنت شركة كيان السعودية عن إلغاء المشروع في نوفمبر 2013م و ذلك بسبب أن نتائج الدراسات الأولية للجدوى الإقتصادية للمشروع لم تتوافق مع سياسة الشركة لمشاريع النمو.</span></span></span></span></li>\r\n</ul>\r\n",
